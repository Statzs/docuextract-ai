# Copy to backend/.env and adjust. Never commit the real .env.

# development | test | production  (production enforces a strong JWT secret,
# Secure cookies, and disables the interactive API docs)
ENVIRONMENT=development

# Local: SQLite file. Production: Supabase Postgres connection string
# (Project Settings -> Database -> Connection string -> "Session pooler" or direct, port 5432).
DATABASE_URL=sqlite:///./docuextract.db
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 32+ random characters. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_MINUTES=720

# JSON list of allowed browser origins (only needed if the frontend is NOT served same-origin)
CORS_ORIGINS=["http://localhost:5173"]

# One server-side key for everyone (users never enter keys). Create it in Google AI Studio
# in a project WITHOUT billing so it can never cost money. Empty: every document is read
# with the free methods (PDF text + Tesseract OCR + rules).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60

MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_BACKOFF_SECONDS=1.0

# Defaults for the limits; the owner can change them live in the admin panel.
# Gemini calls per UTC day (retries count). Over a limit, documents are read without AI.
AI_DAILY_LIMIT_PER_USER=20
AI_DAILY_LIMIT_GLOBAL=200
DAILY_DOCUMENTS_PER_USER=50
OCR_MAX_PAGES=5
# Documents older than this are deleted automatically (0 = keep).
RETENTION_DAYS=30

# Comma-separated emails that may open /app/admin. The account must have signed in
# with Google or GitHub at least once (a verified email).
ADMIN_EMAILS=

# OAuth sign-in. Redirect / callback URL: <APP_URL>/api/auth/oauth/google/callback
# (and .../github/callback). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Password reset. APP_URL is the public frontend URL used in the emailed link.
# Without SMTP_HOST: development prints the link to the server log; production
# disables password reset (the UI hides the link).
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DocuExtract AI <no-reply@example.com>
PASSWORD_RESET_TTL_MINUTES=30

# Origin lock for deployments behind a proxy (Vercel). The proxy adds ORIGIN_SECRET as the
# `x-origin-secret` header; the API refuses requests without it (except /api/health), and
# only then trusts CLIENT_IP_HEADER for the visitor's IP. Leave both empty locally.
ORIGIN_SECRET=
CLIENT_IP_HEADER=
